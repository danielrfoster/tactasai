---
import BaseLayout from "../../layouts/BaseLayout.astro";
import UseCaseDetailPage from "../../components/UseCaseDetailPage.astro";
import { getBrandEmail, getSiteUrl } from "../../lib/site";

const siteUrl = getSiteUrl();
const pageUrl = `${siteUrl}/use-cases/customer-support-ai-agent`;
const brandEmail = getBrandEmail();
const title = "Customer Support AI Agent | Tactas AI";
const description =
  "A managed customer support AI agent that triages tickets, retrieves company knowledge, drafts source-backed replies, and prepares escalations with human review.";

const props = {
  siteUrl,
  currentPath: "/use-cases/customer-support-ai-agent",
  eyebrow: "Customer support AI agent",
  title: "Customer support AI agent for faster, source-backed replies.",
  description:
    "Tactas AI helps support teams turn tickets, customer context, product documentation, policies, and past cases into reviewable summaries, replies, routing decisions, and escalation notes.",
  primaryKeyword: "customer support AI agent",
  secondaryKeywords: ["AI customer support agent", "support ticket automation AI", "AI support ticket triage", "AI knowledge base for support"],
  fit: [
    { title: "Tickets repeat across the queue", body: "Support teammates keep answering similar questions, researching the same docs, and rebuilding the same context." },
    { title: "Answers need trusted sources", body: "Replies depend on product documentation, policy, account history, past tickets, and internal support playbooks." },
    { title: "Escalations lose context", body: "Engineering, billing, success, or security teams receive handoffs without enough summary, impact, or source detail." },
    { title: "Human review still matters", body: "Customer-facing replies, refunds, security issues, and policy exceptions need approval before action." },
  ],
  workflow: [
    { title: "Ticket arrives", body: "A new email, chat, form, or help desk ticket triggers agent review." },
    { title: "Gather context", body: "The agent reads the ticket thread, customer record, plan, past tickets, product docs, and support policy." },
    { title: "Prepare support packet", body: "AI drafts a summary, issue category, relevant sources, risk flags, and recommended next step." },
    { title: "Draft response", body: "The agent prepares a source-backed reply or internal note for a support teammate to review." },
    { title: "Escalate or update", body: "Approved work can become a reply, tag update, escalation task, or internal handoff." },
  ],
  outcomes: [
    { title: "Faster first response", body: "Reduce the time spent searching docs, reading history, and drafting the first useful answer." },
    { title: "More consistent replies", body: "Use the same source-backed support patterns across tickets, channels, and teammates." },
    { title: "Cleaner escalations", body: "Send specialist teams summaries with issue type, customer context, impact, and missing information." },
    { title: "Better knowledge feedback", body: "Spot repeated questions, missing docs, stale macros, and policy gaps from real support work." },
  ],
  integrations: ["Zendesk", "Intercom", "Freshdesk", "HubSpot", "Salesforce", "Gmail", "Slack", "Notion", "Help center", "Internal APIs"],
  faqs: [
    { title: "Can the agent send replies automatically?", body: "The first version usually drafts replies for human review. Low-risk internal updates can become automated after the team proves the workflow." },
    { title: "Can it use our help center and internal docs?", body: "Yes. Tactas AI can connect support documents, product docs, policies, account records, and past ticket examples as operating context." },
    { title: "What is the best first support workflow?", body: "Start with repeated ticket categories where the source material exists and the desired output is easy for a teammate to review." },
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebPage", "@id": `${pageUrl}#webpage`, name: title, url: pageUrl, description, isPartOf: { "@id": `${siteUrl}/#website` }, inLanguage: "en-US" },
    {
      "@type": "Service",
      "@id": `${pageUrl}#service`,
      name: "Customer Support AI Agent",
      serviceType: ["Customer support AI agent", "AI customer support agent", "Support ticket automation AI", "AI support ticket triage"],
      url: pageUrl,
      description,
      provider: { "@id": `${siteUrl}/#organization` },
      areaServed: "Worldwide",
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      mainEntity: props.faqs.map((item) => ({ "@type": "Question", name: item.title, acceptedAnswer: { "@type": "Answer", text: item.body } })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
        { "@type": "ListItem", position: 2, name: "Use Cases", item: `${siteUrl}/use-cases` },
        { "@type": "ListItem", position: 3, name: "Customer Support AI Agent", item: pageUrl },
      ],
    },
    { "@type": "ContactPoint", contactType: "sales", email: brandEmail, areaServed: "Worldwide", availableLanguage: ["en", "vi"] },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical="/use-cases/customer-support-ai-agent"
  currentPath="/use-cases/customer-support-ai-agent"
  navbarTheme="light"
  navbarCtaLabel="Book a review"
  keywords={[
    "customer support AI agent",
    "AI customer support agent",
    "support ticket automation AI",
    "AI support ticket triage",
    "AI customer service automation",
    "AI knowledge base for customer support",
    "managed AI agents for support",
    "help desk AI automation",
  ]}
  openGraph={{ title, description, url: pageUrl, type: "website", images: [{ url: "/tactas-ai-managed-agent-systems-og.jpg", width: 1734, height: 907, alt: "Customer support AI agent for source-backed replies" }] }}
  twitter={{ card: "summary_large_image", title, description, images: ["/tactas-ai-managed-agent-systems-og.jpg"] }}
  jsonLd={jsonLd}
>
  <UseCaseDetailPage {...props} />
</BaseLayout>
