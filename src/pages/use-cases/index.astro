---
import BaseLayout from "../../layouts/BaseLayout.astro";
import UseCasesIndexPage from "../../components/UseCasesIndexPage.astro";
import { getOrganization, getSiteUrl } from "../../lib/site";
import { useCases } from "../../lib/useCases";

const siteUrl = getSiteUrl();
const organization = getOrganization();
const pageUrl = `${siteUrl}/use-cases`;
const ogImage = "/tactas-ai-use-case-hub-ai-agent-workflows-og.jpg";
const ogImageUrl = `${siteUrl}${ogImage}`;
const title = "Enterprise AI Agent Use Case Hub | Tactas AI";
const description =
  "Explore enterprise AI agent use cases for Ops and RevOps teams, including inputs, systems, workflow steps, guardrails, metrics, implementation notes, and structured task review.";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    organization,
    {
      "@type": "CollectionPage",
      "@id": `${pageUrl}#collectionpage`,
      name: "Enterprise AI Agent Use Case Hub",
      url: pageUrl,
      description,
      isPartOf: { "@id": `${siteUrl}/#website` },
      inLanguage: "en-US",
      primaryImageOfPage: ogImageUrl,
      mainEntity: { "@id": `${pageUrl}#itemlist` },
    },
    {
      "@type": "ItemList",
      "@id": `${pageUrl}#itemlist`,
      name: "Tactas AI enterprise use case library",
      numberOfItems: useCases.length,
      itemListElement: useCases.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.title,
        description: item.summary,
        url: `${siteUrl}/use-cases/${item.slug}`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
        { "@type": "ListItem", position: 2, name: "Use Cases", item: pageUrl },
      ],
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical="/use-cases"
  currentPath="/use-cases"
  navbarTheme="light"
  navbarCtaLabel="Book a review"
  keywords={[
    "business task automation use cases",
    "enterprise AI agent use cases",
    "AI agent use case hub",
    "managed AI agents",
    "AI agents for business operations",
    "company knowledge automation",
    "connected business tools",
    "work performance AI",
    "automated business tasks",
    "AI operating layer",
  ]}
  openGraph={{
    title,
    description,
    url: pageUrl,
    type: "website",
    images: [
      {
        url: ogImage,
        width: 1200,
        height: 630,
        alt: "Tactas AI use case hub for AI agent workflows",
      },
    ],
  }}
  twitter={{
    card: "summary_large_image",
    title,
    description,
    images: [ogImage],
  }}
  jsonLd={jsonLd}
>
  <UseCasesIndexPage siteUrl={siteUrl} currentPath="/use-cases" />
</BaseLayout>
