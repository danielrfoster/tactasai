---
import {
  ArrowLeft,
  ArrowRight,
  BarChart3,
  CheckCircle2,
  Database,
  GitBranch,
  Mail,
  PanelTop,
  Send,
  Workflow,
} from "@lucide/astro";
import { getBrandEmail } from "../lib/site";
import type { UseCaseItem } from "../lib/useCases";

interface Props {
  useCase: UseCaseItem;
  relatedUseCases: UseCaseItem[];
}

const { useCase, relatedUseCases } = Astro.props;
const brandEmail = getBrandEmail();
const inquiryPayload = {
  source: "use-case-detail",
  slug: useCase.slug,
  title: useCase.title,
  department: useCase.department,
  industry: useCase.industry,
  workflowType: useCase.workflowType,
  complexity: useCase.complexity,
  systems: useCase.systems,
  primaryOutput: useCase.primaryOutput,
  usefulThings: useCase.usefulThings.map((item) => item.title),
};
---

<main class="min-h-screen bg-[#fbfaf7] text-tactas-ink selection:bg-tactas-accent/20">
  <article>
    <header class="relative overflow-hidden border-b border-black/10 bg-[#fbfaf7]">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-tactas-accent/70 to-transparent"></div>
      <div class="mx-auto w-full max-w-[1180px] px-5 py-10 sm:px-8 lg:px-10 lg:py-16">
        <div class="max-w-[1040px]">
          <a href="/use-cases" class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white px-3 py-1.5 text-[13px] font-semibold text-tactas-muted shadow-sm transition hover:text-tactas-ink-strong">
            <ArrowLeft class="h-4 w-4" stroke-width={1.9} />
            Back to use case hub
          </a>

          <div class="mt-9">
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-tactas-accent-strong">
              {useCase.department} workflow example
            </p>
            <h1 class="mt-5 max-w-[1040px] text-[clamp(2.35rem,5.7vw,4.9rem)] font-semibold leading-[1.02] tracking-normal text-tactas-ink-strong">
              {useCase.title}
            </h1>
            <p class="mt-6 max-w-[860px] text-[19px] font-medium leading-relaxed text-tactas-ink-strong sm:text-[22px]">
              {useCase.shortHeadline}
            </p>
            <p class="mt-5 max-w-[860px] text-[16px] leading-relaxed text-tactas-muted sm:text-[18px]">
              {useCase.opening}
            </p>
          </div>

          <div class="mt-7 flex flex-wrap gap-2">
            {[
              useCase.primaryOutput,
              useCase.buyerRole,
              useCase.industry,
              useCase.complexity,
            ].map((value) => (
              <span class="rounded-full border border-black/10 bg-white px-3.5 py-2 text-[12px] font-semibold text-tactas-muted shadow-sm">{value}</span>
            ))}
          </div>

          <div class="mt-7 rounded-[18px] border border-black/10 bg-white p-5 shadow-sm">
            <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-tactas-muted-soft">What the team can build</p>
            <p class="mt-3 max-w-[880px] text-[15px] leading-relaxed text-tactas-muted">{useCase.builtWith}</p>
          </div>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#task-review" class="inline-flex h-12 items-center justify-center rounded-[14px] bg-tactas-ink-strong px-6 text-[14px] font-semibold text-white transition hover:bg-tactas-primary">
              Plan this use case
              <ArrowRight class="ml-2 h-4 w-4" stroke-width={1.9} />
            </a>
            <a href="/use-cases#use-case-finder" class="inline-flex h-12 items-center justify-center rounded-[14px] border border-black/10 bg-white px-6 text-[14px] font-semibold text-tactas-ink-strong transition hover:border-tactas-accent hover:text-tactas-accent-strong">
              See more examples
            </a>
          </div>
        </div>
      </div>
    </header>

    <section class="border-b border-black/10 bg-white">
      <div class="mx-auto grid w-full max-w-[1180px] gap-8 px-5 py-12 sm:px-8 lg:grid-cols-[0.72fr_1.28fr] lg:px-10 lg:py-16">
        <div>
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-tactas-accent-strong">The problem</p>
          <h2 class="mt-3 text-[34px] font-semibold leading-tight tracking-normal text-tactas-ink-strong sm:text-[46px]">
            Why this work is harder than it should be.
          </h2>
        </div>
        <div class="rounded-[20px] border border-black/10 bg-[#fbfaf7] p-6">
          <p class="text-[18px] leading-relaxed text-tactas-ink-strong">{useCase.problem}</p>
        </div>
      </div>
    </section>

    <section class="border-b border-black/10 bg-[#fbfaf7]">
      <div class="mx-auto grid w-full max-w-[1180px] gap-8 px-5 py-12 sm:px-8 lg:grid-cols-[0.78fr_1.22fr] lg:px-10 lg:py-16">
        <div>
          <div class="flex h-12 w-12 items-center justify-center rounded-[16px] bg-tactas-ink-strong text-white">
            <PanelTop class="h-5 w-5" stroke-width={1.8} />
          </div>
          <p class="mt-6 font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-tactas-accent-strong">What TactasAI helps build</p>
          <h2 class="mt-3 text-[34px] font-semibold leading-tight tracking-normal text-tactas-ink-strong sm:text-[50px]">
            A working surface for the job.
          </h2>
        </div>
        <div class="rounded-[20px] border border-black/10 bg-white p-6">
          <p class="text-[18px] leading-relaxed text-tactas-ink-strong">{useCase.helpsBuild}</p>
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            {useCase.inputs.slice(0, 6).map((input) => (
              <div class="rounded-[14px] border border-black/10 bg-[#fbfaf7] px-4 py-3 text-[14px] font-medium text-tactas-muted">{input}</div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-black/10 bg-white">
      <div class="mx-auto w-full max-w-[1180px] px-5 py-12 sm:px-8 lg:px-10 lg:py-16">
        <div class="mx-auto max-w-[780px] text-center">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-tactas-accent-strong">How it helps the team</p>
          <h2 class="mt-3 text-[34px] font-semibold leading-tight tracking-normal text-tactas-ink-strong sm:text-[50px]">
            Less rediscovery. Better action.
          </h2>
        </div>
        <div class="mt-9 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {useCase.teamBenefits.map((benefit) => (
            <article class="rounded-[20px] border border-black/10 bg-[#fbfaf7] p-5">
              <CheckCircle2 class="h-5 w-5 text-tactas-accent-strong" stroke-width={1.9} />
              <p class="mt-4 text-[15px] leading-relaxed text-tactas-ink-strong">{benefit}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-black/10 bg-[#fbfaf7]">
      <div class="mx-auto grid w-full max-w-[1180px] gap-8 px-5 py-12 sm:px-8 lg:grid-cols-[0.7fr_1.3fr] lg:px-10 lg:py-16">
        <div>
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-tactas-accent-strong">Example workflow</p>
          <h2 class="mt-3 text-[34px] font-semibold leading-tight tracking-normal text-tactas-ink-strong sm:text-[46px]">
            A real scenario, not a generic automation pipeline.
          </h2>
        </div>
        <div class="rounded-[20px] border border-black/10 bg-white p-6">
          <p class="text-[18px] leading-relaxed text-tactas-ink-strong">{useCase.exampleScenario}</p>
        </div>
      </div>
    </section>

    <section class="border-b border-black/10 bg-white">
      <div class="mx-auto w-full max-w-[1180px] px-5 py-12 sm:px-8 lg:px-10 lg:py-16">
        <div class="flex flex-col justify-between gap-4 lg:flex-row lg:items-end">
          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-tactas-accent-strong">What this workflow can create</p>
            <h2 class="mt-3 text-[34px] font-semibold leading-tight tracking-normal text-tactas-ink-strong sm:text-[50px]">
              Useful things the team can actually use.
            </h2>
          </div>
          <p class="max-w-[420px] text-[15px] leading-relaxed text-tactas-muted">
            These are examples of small systems, views, notes, and outputs that make the workflow easier to run next time.
          </p>
        </div>
        <div class="mt-9 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {useCase.usefulThings.map((item) => (
            <article class="rounded-[20px] border border-black/10 bg-[#fbfaf7] p-5">
              <h3 class="text-[20px] font-semibold tracking-normal text-tactas-ink-strong">{item.title}</h3>
              <p class="mt-3 text-[14px] leading-relaxed text-tactas-muted">{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-black/10 bg-[#fbfaf7]">
      <div class="mx-auto grid w-full max-w-[1180px] gap-5 px-5 py-12 sm:px-8 lg:grid-cols-2 lg:px-10 lg:py-16">
        <div class="rounded-[20px] border border-black/10 bg-white p-6">
          <div class="flex items-center gap-3">
            <Workflow class="h-5 w-5 text-tactas-accent-strong" stroke-width={1.8} />
            <h2 class="text-[28px] font-semibold tracking-normal text-tactas-ink-strong">Where it fits</h2>
          </div>
          <p class="mt-4 text-[15px] leading-relaxed text-tactas-muted">
            This can sit around the systems the team already uses. The systems are not the point; the useful working view is.
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            {useCase.systems.map((system) => (
              <span class="rounded-full border border-black/10 bg-[#fbfaf7] px-3 py-1.5 text-[12px] font-semibold text-tactas-muted">{system}</span>
            ))}
          </div>
        </div>

        <div class="rounded-[20px] border border-black/10 bg-white p-6">
          <div class="flex items-center gap-3">
            <Database class="h-5 w-5 text-tactas-accent-strong" stroke-width={1.8} />
            <h2 class="text-[28px] font-semibold tracking-normal text-tactas-ink-strong">When this is worth building</h2>
          </div>
          <div class="mt-5 grid gap-3">
            {useCase.worthBuilding.map((item) => (
              <div class="rounded-[14px] border border-black/10 bg-[#fbfaf7] px-4 py-3 text-[14px] font-medium text-tactas-muted">{item}</div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-black/10 bg-white">
      <div class="mx-auto w-full max-w-[1180px] px-5 py-12 sm:px-8 lg:px-10 lg:py-16">
        <div class="rounded-[20px] border border-black/10 bg-[#fbfaf7] p-6">
          <div class="flex items-center gap-3">
            <BarChart3 class="h-5 w-5 text-tactas-accent-strong" stroke-width={1.8} />
            <h2 class="text-[28px] font-semibold tracking-normal text-tactas-ink-strong">Success metrics</h2>
          </div>
          <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {useCase.metrics.map((metric) => (
              <div class="rounded-[14px] border border-black/10 bg-white px-4 py-3 text-[14px] font-medium text-tactas-muted">{metric}</div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="task-review" class="border-b border-black/10 bg-white">
      <div class="mx-auto w-full max-w-[1180px] px-5 py-12 sm:px-8 lg:px-10 lg:py-16">
        <div class="overflow-hidden rounded-[24px] border border-black/10 bg-tactas-ink-strong text-white lg:grid lg:grid-cols-[0.82fr_1.18fr]">
          <div class="border-b border-white/10 p-6 lg:border-b-0 lg:border-r lg:p-8">
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-tactas-accent">Build with TactasAI</p>
            <h2 class="mt-3 text-[34px] font-semibold leading-tight tracking-normal sm:text-[48px]">
              Plan this use case for your team.
            </h2>
            <p class="mt-4 text-[15px] leading-relaxed text-white/70">
              Share the current workflow, systems, and the working surface you want the team to have.
            </p>
          </div>

          <form id="use-case-detail-form" class="p-6 lg:p-8">
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="grid gap-1.5 text-[11px] font-semibold uppercase tracking-[0.16em] text-white/50">
                Company
                <input name="company" class="h-11 rounded-[14px] border border-white/10 bg-white/10 px-3.5 text-[14px] normal-case tracking-normal text-white outline-none transition placeholder:text-white/38 focus:border-tactas-accent" placeholder="Company name" />
              </label>
              <label class="grid gap-1.5 text-[11px] font-semibold uppercase tracking-[0.16em] text-white/50">
                Work email
                <input required type="email" name="email" class="h-11 rounded-[14px] border border-white/10 bg-white/10 px-3.5 text-[14px] normal-case tracking-normal text-white outline-none transition placeholder:text-white/38 focus:border-tactas-accent" placeholder="you@company.com" />
              </label>
            </div>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              <label class="grid gap-1.5 text-[11px] font-semibold uppercase tracking-[0.16em] text-white/50">
                Urgency
                <select name="urgency" class="h-11 rounded-[14px] border border-white/10 bg-white/10 px-3.5 text-[14px] normal-case tracking-normal text-white outline-none transition focus:border-tactas-accent">
                  <option>This quarter</option>
                  <option>This month</option>
                  <option>Exploring for next quarter</option>
                  <option>Active operational pain</option>
                </select>
              </label>
              <label class="grid gap-1.5 text-[11px] font-semibold uppercase tracking-[0.16em] text-white/50">
                Desired working surface
                <input name="output" value={useCase.primaryOutput} class="h-11 rounded-[14px] border border-white/10 bg-white/10 px-3.5 text-[14px] normal-case tracking-normal text-white outline-none transition focus:border-tactas-accent" />
              </label>
            </div>
            <label class="mt-4 grid gap-1.5 text-[11px] font-semibold uppercase tracking-[0.16em] text-white/50">
              Workflow context
              <textarea name="context" class="min-h-32 rounded-[14px] border border-white/10 bg-white/10 px-3.5 py-3 text-[14px] normal-case tracking-normal text-white outline-none transition placeholder:text-white/38 focus:border-tactas-accent" placeholder="What information is scattered today? What should the team be able to see, do, or reuse?"></textarea>
            </label>
            <button type="submit" class="mt-6 inline-flex h-12 w-full items-center justify-center gap-2 rounded-[14px] bg-white px-6 text-[14px] font-semibold text-tactas-ink-strong transition hover:bg-tactas-accent hover:text-white">
              <Send class="h-4 w-4" stroke-width={2} />
              Request use case review
            </button>
            <p id="use-case-detail-status" class="mt-3 flex items-center justify-center gap-2 text-center text-[12px] text-white/50">
              <Mail class="h-3.5 w-3.5" stroke-width={1.9} />
              Opens email to {brandEmail}
            </p>
          </form>
        </div>
      </div>
    </section>

    {relatedUseCases.length > 0 ? (
      <section class="bg-[#fbfaf7]">
        <div class="mx-auto w-full max-w-[1180px] px-5 py-12 sm:px-8 lg:px-10 lg:py-16">
          <div class="flex flex-col justify-between gap-5 lg:flex-row lg:items-end">
            <div>
              <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-tactas-accent-strong">More examples</p>
              <h2 class="mt-3 text-[34px] font-semibold leading-tight tracking-normal text-tactas-ink-strong sm:text-[46px]">Related workflows.</h2>
            </div>
            <a href="/use-cases#use-case-finder" class="inline-flex items-center text-[14px] font-semibold text-tactas-accent-strong transition hover:text-tactas-primary-strong">
              Open finder
              <ArrowRight class="ml-1.5 h-3.5 w-3.5" stroke-width={1.9} />
            </a>
          </div>
          <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            {relatedUseCases.map((item) => (
              <a href={`/use-cases/${item.slug}`} class="group rounded-[20px] border border-black/10 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-tactas-accent/55">
                <GitBranch class="h-5 w-5 text-tactas-accent-strong" stroke-width={1.8} />
                <p class="mt-5 font-mono text-[10px] uppercase tracking-[0.18em] text-tactas-muted-soft">{item.department}</p>
                <h3 class="mt-3 text-[18px] font-semibold leading-tight text-tactas-ink-strong group-hover:text-tactas-accent-strong">{item.title}</h3>
                <p class="mt-3 line-clamp-3 text-[13px] leading-relaxed text-tactas-muted">{item.summary}</p>
                <p class="mt-5 text-[12px] font-semibold text-tactas-muted-soft">{item.primaryOutput}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    ) : null}
  </article>

  <script define:vars={{ brandEmail, inquiryPayload, useCaseTitle: useCase.title }} is:inline>
    const form = document.getElementById("use-case-detail-form");
    const status = document.getElementById("use-case-detail-status");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const payload = {
        ...inquiryPayload,
        company: String(data.get("company") || ""),
        email: String(data.get("email") || ""),
        urgency: String(data.get("urgency") || ""),
        desiredOutput: String(data.get("output") || ""),
        context: String(data.get("context") || ""),
      };
      const body = [
        `Use case review: ${useCaseTitle}`,
        "",
        `Company: ${payload.company}`,
        `Work email: ${payload.email}`,
        `Urgency: ${payload.urgency}`,
        `Desired working surface: ${payload.desiredOutput}`,
        "",
        "Workflow context:",
        payload.context,
        "",
        "Structured payload:",
        JSON.stringify(payload, null, 2),
      ].join("\n");
      if (status) status.textContent = "Opening your email client with the use case details.";
      window.location.href = `mailto:${brandEmail}?subject=${encodeURIComponent(`Use case review - ${useCaseTitle}`)}&body=${encodeURIComponent(body)}`;
    });
  </script>
</main>
