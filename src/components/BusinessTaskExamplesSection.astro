                                        <Check class="mt-0.5 h-3.5 w-3.5 shrink-0 text-tactas-accent" stroke-width={2.6} />
                                        <div class="flex-1">
                                          <p class="text-[13.5px] leading-relaxed text-tactas-muted">
                                            <span class="font-semibold text-tactas-ink">{label}:</span> {value}
                                          </p>
                                        </div>
                                        <span class:list={[
                                          "shrink-0 rounded-full px-1.5 py-0.5 font-mono text-[9.5px] font-semibold uppercase tracking-wider",
                                          prio === "High" ? "bg-tactas-danger-soft text-tactas-danger" : "bg-tactas-warning-soft text-tactas-warning-strong",
                                        ]}>{prio}</span>
                                      </div>
                                    ))}
                                  </div>
                                </div>
                              </div>
                            </div>

                            <div class="flex justify-end">
                              <div class="flex max-w-[78%] flex-col items-end gap-1">
                                <div class="rounded-[12px] rounded-br-[3px] bg-tactas-accent px-3.5 py-2.5 text-[14px] leading-relaxed text-white shadow-[0_8px_20px_-16px_rgba(15,23,42,0.5)]">
                                  Draft the follow-ups and assign the owners.
                                </div>
                                <p class="flex items-center gap-1 pr-1 text-[10px] text-tactas-muted-soft">
                                  <span>Team &middot; 4:20 PM</span>
                                  <CheckCheck class="h-3 w-3 text-tactas-accent" stroke-width={2.2} />
                                </p>
                              </div>
                            </div>
                          </>
                        )}
                      </div>
                    </div>
                  ))}
                </div>

                <div class="border-t border-tactas-line-soft bg-white p-3 sm:px-4 sm:py-3.5">
                  <div class="rounded-[10px] border border-tactas-line-strong bg-tactas-bg-soft shadow-[inset_0_1px_0_rgba(255,255,255,0.8)] transition focus-within:border-tactas-accent focus-within:bg-white focus-within:shadow-[0_0_0_3px_rgba(6,182,212,0.2)]">
                    <div class="flex items-center gap-2 px-3.5 py-2.5">
                      <p class="flex-1 text-[13.5px] text-tactas-muted-soft">Ask Tactas to handle work&hellip;</p>
                    </div>
                    <div class="flex items-center justify-between border-t border-tactas-line-soft/80 px-2 py-1.5">
                      <div class="flex items-center gap-0.5 text-tactas-muted-soft">
                        <button type="button" class="inline-flex h-7 items-center gap-1 rounded-[5px] px-2 text-[11px] font-medium transition hover:bg-white hover:text-tactas-ink" aria-label="Attach file">
                          <Paperclip class="h-3.5 w-3.5" stroke-width={1.9} />
                          <span class="hidden sm:inline">Attach</span>
                        </button>
                        <button type="button" class="inline-flex h-7 items-center gap-1 rounded-[5px] px-2 text-[11px] font-medium transition hover:bg-white hover:text-tactas-ink" aria-label="Suggest action">
                          <Sparkles class="h-3.5 w-3.5" stroke-width={1.9} />
                          <span class="hidden sm:inline">Suggest</span>
                        </button>
                        <span class="ml-1 hidden h-3.5 w-px bg-tactas-line-soft sm:block"></span>
                        <span class="ml-1.5 hidden items-center gap-1 rounded-full bg-tactas-success-soft px-2 py-0.5 text-[10px] font-medium text-tactas-success-strong sm:flex">
                          <ShieldCheck class="h-3 w-3" stroke-width={2} />
                          Automated
                        </span>
                      </div>
                      <button type="button" class="inline-flex h-8 items-center gap-1.5 rounded-[6px] bg-tactas-accent px-3.5 text-[12px] font-semibold text-white transition hover:bg-tactas-accent" aria-label="Send message">
                        Send
                        <Send class="h-3.5 w-3.5" stroke-width={2} />
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <aside class="hidden border-t border-tactas-line-soft bg-tactas-bg-soft lg:block lg:border-t-0 lg:border-l" aria-label="Task context">
                {exampleOperators.map((op, idx) => (
                  <div
                    id={`example-context-${op.id}`}
                    class:list={[
                      "example-context flex h-full flex-col px-4 py-4",
                      idx === 0 ? "" : "hidden",
                    ]}
                  >
                    <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-tactas-muted-soft">Task context</p>

                    <div class="mt-4 space-y-3">
                      <div class="rounded-[8px] border border-tactas-line-soft bg-white p-3">
                        <p class="font-mono text-[9.5px] uppercase tracking-[0.18em] text-tactas-muted-soft">Intent</p>
                        <p class="mt-1.5 text-[12.5px] font-semibold leading-snug text-tactas-ink">{op.intent}</p>
                      </div>
                      <div class="rounded-[8px] border border-tactas-line-soft bg-white p-3">
                        <p class="font-mono text-[9.5px] uppercase tracking-[0.18em] text-tactas-muted-soft">Sources</p>
                        <p class="mt-1.5 text-[12px] leading-relaxed text-tactas-muted">{op.sources}</p>
                      </div>
                      <div class="rounded-[8px] border border-tactas-line-soft bg-white p-3">
                        <p class="font-mono text-[9.5px] uppercase tracking-[0.18em] text-tactas-muted-soft">Suggested next step</p>
                        <p class="mt-1.5 text-[12.5px] font-semibold text-tactas-accent">{op.nextAction}</p>
                      </div>
                    </div>

                    <div class="mt-4 rounded-[8px] border border-tactas-line-soft bg-white p-3">
                      <div class="flex items-center justify-between">
                        <p class="font-mono text-[9.5px] uppercase tracking-[0.18em] text-tactas-muted-soft">Connectors</p>
                        <span class="text-[11px] font-semibold text-tactas-ink">{op.connectors}</span>
                      </div>
                      <div class="mt-2 flex flex-wrap gap-1">
                        {op.sources.split(", ").slice(0, 4).map((source) => (
                          <span class="rounded-[4px] border border-tactas-line-soft bg-tactas-bg px-1.5 py-0.5 text-[10px] font-medium text-tactas-muted-soft">
                            {source}
                          </span>
                        ))}
                      </div>
                    </div>

                    <div class="mt-auto pt-4">
                      <div class="rounded-[8px] border border-tactas-accent-line bg-tactas-accent-soft p-3">
                        <div class="flex items-center gap-2">
                          <ShieldCheck class="h-3.5 w-3.5 text-tactas-accent-strong" stroke-width={2} />
                          <p class="text-[11px] font-semibold text-tactas-accent-strong">Operating flow</p>
                        </div>
                        <p class="mt-1.5 text-[11px] leading-relaxed text-tactas-accent-strong">
                          Each task keeps the request, sources, prepared output, and next action together.
                        </p>
                      </div>
                    </div>
                  </div>
                ))}
              </aside>
            </div>
          </div>
        </div>
      </div>
    </section>


<style is:global>

  .example-conversation [class*="border-l-tactas-accent"] {
    background-image: linear-gradient(180deg, var(--bg-raised) 0%, var(--bg) 100%);
  }

  .example-panel.is-playing .example-conversation > * {
    animation: tactas-message-in 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--message-index, 0) * 420ms);
  }

  .example-panel.is-playing .example-conversation > *:first-child {
    animation-duration: 300ms;
  }

  .example-panel.is-playing .example-conversation > *:has(.tactas-dot) {
    animation-duration: 360ms;
  }

  .tactas-dot {
    animation: tactas-typing 1.2s ease-in-out infinite;
  }

  @keyframes tactas-message-in {
    0% {
      opacity: 0;
      transform: translateY(10px) scale(0.985);
      filter: blur(3px);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  @keyframes tactas-typing {
    0%, 60%, 100% { opacity: 0.35; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(-2px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .example-panel.is-playing .example-conversation > *,
    .tactas-dot {
      animation: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const ACTIVE_CLASSES = [
      "border-tactas-accent-line",
      "bg-white",
      "shadow-[inset_3px_0_0_0_var(--accent),0_12px_26px_-22px_rgba(8,145,178,0.45)]",
    ];
    const INACTIVE_CLASSES = ["border-transparent", "hover:border-tactas-line-soft", "hover:bg-white"];

    const syncExampleTabs = () => {
      const tabs = Array.from(document.querySelectorAll("[data-example-tab]"));
      const panels = Array.from(document.querySelectorAll(".example-panel"));
      const contexts = Array.from(document.querySelectorAll(".example-context"));
      if (!tabs.length || !panels.length) return;

      const preparePanel = (panel) => {
        const items = Array.from(panel.querySelectorAll(".example-conversation > *"));
        items.forEach((item, index) => {
          item.style.setProperty("--message-index", String(index));
        });
      };

      const playPanel = (panel) => {
        if (!panel) return;
        panel.classList.remove("is-playing");
        void panel.offsetWidth;
        panel.classList.add("is-playing");
      };

      panels.forEach(preparePanel);
      playPanel(panels.find((panel) => !panel.classList.contains("hidden")));

      tabs.forEach((tab) => {
        if (tab.dataset.exampleBound === "true") return;
        tab.dataset.exampleBound = "true";
        tab.addEventListener("click", () => {
          const target = tab.getAttribute("data-example-tab");
          let activePanel = null;
          tabs.forEach((item) => {
            const active = item === tab;
            item.setAttribute("aria-selected", active ? "true" : "false");
            ACTIVE_CLASSES.forEach((cls) => item.classList.toggle(cls, active));
            INACTIVE_CLASSES.forEach((cls) => item.classList.toggle(cls, !active));
          });
          panels.forEach((panel) => {
            const active = panel.id === `example-panel-${target}`;
            panel.classList.toggle("hidden", !active);
            panel.classList.toggle("is-playing", false);
            if (active) activePanel = panel;
          });
          contexts.forEach((ctx) => {
            ctx.classList.toggle("hidden", ctx.id !== `example-context-${target}`);
          });
          playPanel(activePanel);
        });
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", syncExampleTabs, { once: true });
    } else {
      syncExampleTabs();
    }

    document.addEventListener("astro:page-load", syncExampleTabs);
  })();
</script>
