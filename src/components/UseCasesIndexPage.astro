---
import { ArrowRight, Bot, Briefcase, Database, FileText, Plus, Search, ShieldCheck, Sparkles, Workflow } from "@lucide/astro";
import { getBrandEmail } from "../lib/site";
import {
  getFeaturedUseCases,
  outputTypes,
  useCaseComplexities,
  useCaseDepartments,
  useCaseIndustries,
  useCases,
  useCaseWorkflowTypes,
} from "../lib/useCases";
import UseCaseHubFinder from "./UseCaseHubFinder";

interface Props {
  siteUrl: string;
  currentPath?: string;
}

const brandEmail = getBrandEmail();
const featuredUseCases = getFeaturedUseCases();
const categoryCards = [
  {
    label: "Support",
    href: "#use-case-finder",
    count: useCases.filter((item) => item.department === "Support").length,
    body: "Resolution packages, diagnostic assets, escalation workspaces, and reusable support material.",
    icon: FileText,
  },
  {
    label: "RevOps",
    href: "#use-case-finder",
    count: useCases.filter((item) => item.department === "RevOps").length,
    body: "Account workspaces, scoring workflows, deal packages, and system update proposals.",
    icon: Briefcase,
  },
  {
    label: "Operations",
    href: "#use-case-finder",
    count: useCases.filter((item) => item.department === "Operations").length,
    body: "Reusable operating workflows, work queues, approval packages, and status assets.",
    icon: Workflow,
  },
  {
    label: "Security",
    href: "#use-case-finder",
    count: useCases.filter((item) => item.department === "Security").length,
    body: "Evidence workspaces, access review systems, risk packages, and incident assets.",
    icon: ShieldCheck,
  },
];
---

<div class="min-h-screen bg-[#fbfaf7] text-tactas-ink selection:bg-tactas-accent/20">
  <main>
    <section class="relative overflow-hidden border-b border-black/10 bg-[#fbfaf7]">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-tactas-accent/70 to-transparent"></div>
      <div class="mx-auto flex w-full max-w-[1180px] flex-col items-center px-5 pb-12 pt-14 text-center sm:px-8 lg:px-10 lg:pb-16 lg:pt-18">
        <a href="/" class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white px-3 py-1.5 text-[13px] font-semibold text-tactas-ink shadow-sm">
          <Bot class="h-4 w-4 text-tactas-accent-strong" stroke-width={1.9} />
          Tactas AI use cases
        </a>

        <h1 class="mt-8 max-w-[960px] text-[clamp(3rem,8vw,6.4rem)] font-semibold leading-[0.95] tracking-normal text-tactas-ink-strong">
          Discover what teams can build with Tactas AI.
        </h1>
        <p class="mt-6 max-w-[720px] text-[17px] leading-relaxed text-tactas-muted sm:text-[19px]">
          Browse practical workflow examples by team, industry, system, and working surface. See what a team could build around repeated business work.
        </p>

        <div class="mt-8 flex w-full max-w-[760px] items-center gap-3 rounded-[20px] border border-black/10 bg-white p-2 shadow-[0_24px_70px_-52px_rgba(15,23,42,0.28)]">
          <Search class="ml-3 h-5 w-5 shrink-0 text-tactas-muted-soft" stroke-width={1.9} />
          <a href="#use-case-finder" class="flex min-h-12 flex-1 items-center text-left text-[15px] text-tactas-muted-soft">
            Search 55 workflow examples by team, system, or output
          </a>
          <a href="#use-case-finder" class="inline-flex h-11 shrink-0 items-center justify-center rounded-[14px] bg-tactas-ink-strong px-4 text-[13px] font-semibold text-white transition hover:bg-tactas-primary">
            Explore
          </a>
        </div>

        <div class="mt-7 flex flex-wrap justify-center gap-2">
          {["Featured", "Latest", "Popular", "Support", "RevOps", "Operations", "Security", "Ecommerce"].map((item) => (
            <a href="#use-case-finder" class="rounded-full border border-black/10 bg-white px-4 py-2 text-[13px] font-semibold text-tactas-muted transition hover:border-tactas-accent-line hover:text-tactas-accent-strong">
              {item}
            </a>
          ))}
        </div>

        <div class="mt-10 grid w-full gap-3 sm:grid-cols-3">
          {[
            ["55", "use cases"],
            [String(useCaseDepartments.length), "teams"],
            [String(new Set(useCases.flatMap((item) => item.systems)).size), "systems"],
          ].map(([value, label]) => (
            <div class="rounded-[16px] border border-black/10 bg-white/70 px-5 py-4">
              <p class="text-[28px] font-semibold leading-none text-tactas-ink-strong">{value}</p>
              <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.18em] text-tactas-muted-soft">{label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-black/10 bg-white">
      <div class="mx-auto w-full max-w-[1180px] px-5 py-10 sm:px-8 lg:px-10 lg:py-14">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-tactas-accent-strong">Browse by category</p>
            <h2 class="mt-3 text-[32px] font-semibold leading-tight tracking-normal text-tactas-ink-strong sm:text-[44px]">
              Start with a team.
            </h2>
          </div>
          <a href="#use-case-finder" class="inline-flex items-center text-[14px] font-semibold text-tactas-accent-strong transition hover:text-tactas-primary-strong">
            View all categories
            <ArrowRight class="ml-1.5 h-3.5 w-3.5" stroke-width={1.9} />
          </a>
        </div>

        <div class="mt-7 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          {categoryCards.map((category) => {
            const Icon = category.icon;
            return (
              <a href={category.href} class="group rounded-[18px] border border-black/10 bg-[#fbfaf7] p-5 transition hover:-translate-y-0.5 hover:border-tactas-accent-line hover:bg-white hover:shadow-[0_24px_70px_-56px_rgba(15,23,42,0.25)]">
                <div class="flex items-center justify-between gap-3">
                  <span class="flex h-11 w-11 items-center justify-center rounded-[14px] bg-white text-tactas-accent-strong shadow-sm">
                    <Icon class="h-5 w-5" stroke-width={1.8} />
                  </span>
                  <span class="rounded-full border border-black/10 bg-white px-2.5 py-1 font-mono text-[10px] text-tactas-muted-soft">{category.count} cases</span>
                </div>
                <h3 class="mt-5 text-[21px] font-semibold tracking-normal text-tactas-ink-strong group-hover:text-tactas-accent-strong">{category.label}</h3>
                <p class="mt-2 text-[14px] leading-relaxed text-tactas-muted">{category.body}</p>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <section class="border-b border-black/10 bg-[#fbfaf7]">
      <div class="mx-auto w-full max-w-[1180px] px-5 py-10 sm:px-8 lg:px-10 lg:py-14">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-tactas-accent-strong">Featured</p>
            <h2 class="mt-3 text-[32px] font-semibold leading-tight tracking-normal text-tactas-ink-strong sm:text-[44px]">
              Highlighted workflows.
            </h2>
          </div>
          <a href="#use-case-finder" class="inline-flex items-center text-[14px] font-semibold text-tactas-accent-strong transition hover:text-tactas-primary-strong">
            Browse all {useCases.length}
            <ArrowRight class="ml-1.5 h-3.5 w-3.5" stroke-width={1.9} />
          </a>
        </div>

        <div class="mt-7 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {featuredUseCases.map((item, index) => (
            <a href={`/use-cases/${item.slug}`} class="group overflow-hidden rounded-[20px] border border-black/10 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-[0_28px_80px_-56px_rgba(15,23,42,0.34)]">
              <div class:list={[
                "flex min-h-32 items-start justify-between p-5",
                index % 3 === 0 ? "bg-[linear-gradient(135deg,#e8fbff_0%,#f4f7ff_100%)]" : index % 3 === 1 ? "bg-[linear-gradient(135deg,#f7f1ff_0%,#eef7ff_100%)]" : "bg-[linear-gradient(135deg,#fff7e6_0%,#eefcff_100%)]",
              ]}>
                <span class="rounded-full border border-black/10 bg-white/80 px-3 py-1 text-[12px] font-semibold text-tactas-ink">{item.department}</span>
                <Sparkles class="h-5 w-5 text-tactas-accent-strong" stroke-width={1.8} />
              </div>
              <div class="p-5">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-tactas-muted-soft">Built with Tactas AI</p>
                <h3 class="mt-3 text-[22px] font-semibold leading-tight tracking-normal text-tactas-ink-strong group-hover:text-tactas-accent-strong">{item.title}</h3>
                <p class="mt-3 line-clamp-3 text-[14px] leading-relaxed text-tactas-muted">{item.summary}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  <span class="rounded-full bg-tactas-bg px-3 py-1 text-[11px] font-medium text-tactas-muted">{item.workflowType}</span>
                  <span class="rounded-full bg-tactas-bg px-3 py-1 text-[11px] font-medium text-tactas-muted">{item.primaryOutput}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <UseCaseHubFinder
      client:load
      useCases={useCases}
      departments={useCaseDepartments}
      industries={useCaseIndustries}
      workflowTypes={useCaseWorkflowTypes}
      complexities={useCaseComplexities}
      outputTypes={outputTypes}
      brandEmail={brandEmail}
    />

    <section class="bg-white">
      <div class="mx-auto w-full max-w-[1180px] px-5 py-12 sm:px-8 lg:px-10 lg:py-16">
        <div class="rounded-[20px] border border-black/10 bg-tactas-ink-strong p-6 text-white sm:p-8 lg:flex lg:items-center lg:justify-between lg:gap-10">
          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-tactas-accent">Share a workflow</p>
            <h2 class="mt-3 text-[32px] font-semibold leading-tight tracking-normal sm:text-[44px]">
              Have a repeated task that should be in the library?
            </h2>
            <p class="mt-4 max-w-[620px] text-[15px] leading-relaxed text-white/72">
              Send the task, systems, and working surface you want. Tactas AI can help shape the workflow around it.
            </p>
          </div>
          <a href="#task-fit" class="mt-7 inline-flex h-12 items-center justify-center rounded-[14px] bg-white px-5 text-[14px] font-semibold text-tactas-ink-strong transition hover:bg-tactas-accent hover:text-white lg:mt-0">
            <Plus class="mr-2 h-4 w-4" stroke-width={2} />
            Submit use case
          </a>
        </div>
      </div>
    </section>
  </main>
</div>
