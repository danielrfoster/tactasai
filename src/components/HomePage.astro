      ["GitLab", "gitlab", "color"],
      ["Cloudflare", "cloudflare", "color"],
      ["Vercel", "vercel", "color"],
      ["Netlify", "netlify", "color"],
      ["Docker", "docker", "color"],
      ["Postman", "postman", "color"],
      ["Zapier", "zapier", "color"],
      ["Snowflake", "snowflake", "color"],
      ["MongoDB", "mongodb", "color"],
      ["Redis", "redis", "color"],
      ["Elastic", "elastic", "color"],
      ["Sentry", "sentry", "color"],
