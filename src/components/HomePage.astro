const integrationFeatureNodes = [
  { title: "Knowledge", x: 430, y: 148, width: 170, feature: "activity" },
  { title: "Tasks", x: 950, y: 124, width: 136, feature: "tasks" },
  { title: "Outputs", x: 360, y: 398, width: 154, feature: "projects" },
  { title: "Teams", x: 990, y: 398, width: 142, feature: "people" },
  { title: "Data", x: 660, y: 536, width: 118, feature: "data" },
];

const featureOrbit = {
  activity: { rx: 210, ry: 118, start: -2.65 },
  tasks: { rx: 205, ry: 118, start: -1.35 },
  projects: { rx: 215, ry: 126, start: -2.95 },
  people: { rx: 205, ry: 126, start: -0.55 },
  data: { rx: 260, ry: 118, start: 0.05 },
};

const rawIntegrationNodes = integrationGroups.flatMap((group, groupIndex) =>
  group.logos.map(([label, slug, source, logoStyle], itemIndex) => ({
    label,
    slug,
    source,
    logoStyle,
    accent: group.accent,
    feature:
      groupIndex === 0
        ? itemIndex < 8
          ? "activity"
          : "projects"
        : groupIndex === 1
          ? "people"
          : groupIndex === 2
            ? "tasks"
            : "data",
  })),
);

const featureCounts = rawIntegrationNodes.reduce((counts, node) => {
  counts[node.feature] = (counts[node.feature] || 0) + 1;
  return counts;
}, {});
const featureSeen = {};

const integrationNodes = rawIntegrationNodes.map((node) => {
  const feature = integrationFeatureNodes.find((item) => item.feature === node.feature) || integrationFeatureNodes[0];
  const orbit = featureOrbit[node.feature];
  const localIndex = featureSeen[node.feature] || 0;
  featureSeen[node.feature] = localIndex + 1;
  const count = featureCounts[node.feature];
  const angle = orbit.start + (localIndex * Math.PI * 2) / count;
  const radiusScale = localIndex % 3 === 0 ? 0.78 : localIndex % 3 === 1 ? 1 : 1.16;

  return {
    ...node,
    anchorX: feature.x,
    anchorY: feature.y,
    x: Math.max(46, Math.min(1194, feature.x + Math.cos(angle) * orbit.rx * radiusScale)),
    y: Math.max(46, Math.min(594, feature.y + Math.sin(angle) * orbit.ry * radiusScale)),
  };
});

---

<div class="tactas-home-style min-h-screen bg-tactas-bg text-tactas-ink">

  <main>
    <SharedHero
      eyebrow="AI that knows your business inside out"
      eyebrowMessages={heroEyebrowMessages}
      titleLines={["AI agents built for the way", "your business works."]}
      body="TactasAI deploys managed AI agents that learn your company context, work with your team, and turn business knowledge into useful outputs and action."
      primaryAction={{ label: "Book an operator review", href: "/contact" }}
      secondaryAction={{ label: "Explore the operating layer", href: "#platform" }}
      proofItems={[
        { label: "Company context", icon: Network },
        { label: "Team workflow", icon: ShieldCheck },
        { label: "Action-ready outputs", icon: Zap },
      ]}
    />

    <BusinessTaskExamplesSection />

    <section class="tactas-difference-section relative overflow-hidden border-b border-tactas-line bg-tactas-night-strong text-white">
      <img
        src="/tactasai-agent-workspace-background.png"
        alt=""
        loading="lazy"
        decoding="async"
        class="tactas-difference-image absolute inset-0 h-full w-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(7,17,31,0.84)_0%,rgba(7,17,31,0.66)_36%,rgba(37,99,235,0.22)_68%,rgba(6,182,212,0.08)_100%)]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(247,249,252,0.08)_0%,rgba(7,17,31,0.03)_40%,rgba(7,17,31,0.22)_100%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_78%_24%,rgba(6,182,212,0.16)_0%,transparent_34%),radial-gradient(circle_at_52%_78%,rgba(37,99,235,0.14)_0%,transparent_36%)]"></div>
      <div class={`tactas-container relative py-16 lg:py-20`}>
        <div class="max-w-[800px]">
          <div class="tactas-difference-copy border-l border-white/22 pl-5 sm:pl-7">
            <p class="font-mono text-[11px] uppercase tracking-[0.24em] text-tactas-accent-line">What makes TactasAI different</p>
            <h2 class="mt-5 max-w-[760px] text-[38px] font-semibold leading-[1.02] tracking-normal text-white sm:text-[54px]">
              Agents build the tools they need to work.
            </h2>
            <p class="mt-6 max-w-[720px] text-[18px] leading-[1.62] text-white/82">
              Most agents depend on prompts, connected tools, and predefined workflows. TactasAI gives agents a controlled workspace where they can create their own tools, interfaces, and operating logic, then reuse them with your team across recurring business work.
            </p>
            <p class="mt-5 max-w-[700px] text-[18px] font-semibold leading-relaxed text-white">
              Each task can improve the system, not just produce an output.
            </p>
            <a href="#platform" class="mt-8 inline-flex h-12 items-center justify-center gap-2 rounded-[8px] border border-white/20 bg-white/10 px-5 text-[14px] font-semibold text-white backdrop-blur transition hover:border-tactas-accent-line hover:bg-white hover:text-tactas-ink-strong">
              Explore how the workspace works
              <ArrowUpRight class="h-4 w-4" stroke-width={2} />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="solutions" class="relative overflow-hidden border-b border-tactas-line bg-tactas-bg">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-px tactas-gradient-rule"></div>
      <div class={`tactas-container py-16 lg:py-20`}>
        <div class="grid gap-8 lg:grid-cols-[minmax(0,0.98fr)_minmax(360px,0.74fr)] lg:items-end lg:justify-between">
          <div>
            <p class="font-mono text-[11px] uppercase tracking-[0.24em] text-tactas-accent-strong">Operating pattern</p>
            <h2 class="mt-4 max-w-[760px] text-[38px] font-semibold leading-[1.02] tracking-normal text-tactas-ink-strong sm:text-[56px]">
              A practical loop for turning requests into finished work.
            </h2>
          </div>
          <div class="grid gap-5 lg:justify-self-end lg:pb-1">
            <p class="max-w-[39rem] text-[16px] leading-relaxed text-tactas-ink-strong/78">
              Each task moves through the same operating pattern: understand the request, prepare the work, automate the routine steps, then track what remains open.
            </p>
            <div class="flex flex-wrap gap-2">
              {["Understand", "Create", "Automate", "Improve"].map((item) => (
                <span class="rounded-full border border-tactas-line-strong bg-white/70 px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-tactas-ink-strong">{item}</span>
              ))}
            </div>
          </div>
        </div>

        <div class="capability-carousel relative mt-10 overflow-hidden border border-tactas-line bg-white shadow-[0_34px_100px_-68px_rgba(7,17,31,0.38)]">
          <div class="grid grid-cols-2 border-b border-tactas-line-soft bg-tactas-bg sm:grid-cols-4">
            {capabilitySlices.map((slice, index) => (
              <div class="border-r border-tactas-line-soft px-4 py-3 last:border-r-0">
                <div class="mb-2 flex items-center justify-between gap-2">
                  <span class="text-[12px] font-semibold text-tactas-ink-strong">{slice.label}</span>
                  <span class="font-mono text-[10px] text-tactas-muted-soft">{slice.phase}</span>
                </div>
                <div class="capability-carousel-step h-1 overflow-hidden rounded-full bg-tactas-line-soft" style={`--panel-delay: ${index * 4.8}s;`}>
                  <span class:list={["block h-full w-full origin-left scale-x-0 rounded-full", slice.accent]}></span>
                </div>
              </div>
            ))}
          </div>

          <div class="relative min-h-[760px] overflow-hidden sm:min-h-[650px] lg:min-h-[430px]">
            {capabilitySlices.map((slice, index) => {
                const Icon = slice.icon;
                return (
                  <section
                    class="capability-carousel-panel absolute inset-0 overflow-hidden bg-white"
                    style={`--panel-delay: ${index * 4.8}s;`}
                  >
                    <div class="grid h-full lg:grid-cols-[0.9fr_1.1fr]">
                      <div class="relative flex flex-col justify-between border-b border-tactas-line-soft bg-tactas-night-strong p-6 text-white sm:p-8 lg:border-b-0 lg:border-r">
                        <div>
                          <div class="flex items-center gap-3">
