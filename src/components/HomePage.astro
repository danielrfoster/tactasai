      ["Notion", "notion", "color"],
      ["Confluence", "confluence", "color"],
      ["Asana", "asana", "color"],
      ["Trello", "trello", "color"],
      ["Jira", "jira", "color"],
      ["Airtable", "airtable", "color"],
      ["ClickUp", "clickup", "color"],
      ["Miro", "miro", "color"],
      ["Figma", "figma", "color"],
      ["Canva", "canva", "multi"],
