                          ))}
                        </div>
                      </div>

                      <div class="grid gap-4 p-5 sm:p-7 lg:grid-cols-[1fr_0.92fr] lg:content-center">
                        <div class="grid gap-3">
                          {slice.cardIndexes.map((cardIndex) => {
                            const card = solutionCards[cardIndex];
                            const CardIcon = card.icon;
                            return (
                              <article class="capability-carousel-chip border border-tactas-line bg-tactas-bg p-4">
                                <div class="flex items-start gap-3">
                                  <span class:list={["flex h-9 w-9 shrink-0 items-center justify-center rounded-[7px] border bg-white", slice.borderAccent, slice.textAccent]}>
                                    <CardIcon class="h-4.5 w-4.5" stroke-width={1.9} />
                                  </span>
                                  <div>
                                    <h4 class="text-[17px] font-semibold tracking-normal text-tactas-ink-strong">{card.title}</h4>
                                    <p class="mt-1.5 text-[13px] leading-relaxed text-tactas-muted">{card.body}</p>
                                  </div>
                                </div>
                              </article>
                            );
                          })}
                        </div>

                        <div class:list={["border p-4", slice.borderAccent, slice.tint]}>
                          <p class:list={["font-mono text-[10px] uppercase tracking-[0.2em]", slice.textAccent]}>Prepared output</p>
                          <h4 class="mt-3 text-[23px] font-semibold leading-tight tracking-normal text-tactas-ink-strong">{slice.outputTitle}</h4>
                          <p class="mt-2 text-[13.5px] leading-relaxed text-tactas-muted">{slice.outputBody}</p>
                          <div class="mt-5 grid gap-2">
                            {slice.memory.map((item) => (
                              <div class="flex items-center justify-between gap-3 border-b border-black/10 pb-2 text-[13px] font-medium text-tactas-muted last:border-b-0 last:pb-0">
                                <span>{item}</span>
                                <Check class:list={["h-3.5 w-3.5", slice.textAccent]} stroke-width={2.6} />
                              </div>
                            ))}
                          </div>
                        </div>
                      </div>
                    </div>
